---
import { Image } from 'astro:assets';
import exterior from '../assets/images/exterior-night.jpg';
import logo from '../assets/images/amis-logo.jpg';
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__media"><Image src={exterior} alt="夜のシンガポール アミス店舗外観" widths={[640, 960, 1440]} sizes="100vw" loading="eager" /></div>
  <div class="hero__shade"></div>
  <div class="hero__content shell">
    <div class="hero__logo-wrap" data-hero-reveal>
      <Image class="hero__logo" src={logo} alt="SINGAPORE AMIS ASIAN DINING & BAR ロゴ" widths={[160, 240, 320]} sizes="(max-width: 820px) 36vw, 210px" />
    </div>
    <div class="hero__copy">
      <p class="hero__kicker" data-hero-reveal>ASIAN DINING IN YOKOHAMA</p>
      <h1 id="hero-title" data-hero-reveal><span>香りで旅する、</span><span>アジアの食卓。</span></h1>
      <p class="hero__lead" data-hero-reveal>シンガポールを中心に、アジア各地の味が集う小さなダイニング。<br />ランチも、夜の一杯も、心ほどけるひと皿とともに。</p>
      <div class="hero__actions" data-hero-reveal>
        <a class="button button--fill" href="#popular">人気メニューを見る</a>
        <a class="button button--ghost" href={site.phoneHref}>電話で予約する</a>
      </div>
    </div>
  </div>
  <div class="hero__meta"><span>KANAGAWA-SHINMACHI</span><span>EST. YOKOHAMA</span></div>
  <a class="hero__scroll" href="#about" aria-label="下へスクロール"><span>SCROLL</span><i></i></a>
</section>
